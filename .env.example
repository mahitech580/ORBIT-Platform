# Copy to .env for local development. Never use these sample values in production.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-local-secret
ENABLE_DEMO_AUTH=true
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
PORT=5000

# For Render, set DATABASE_URL to the private PostgreSQL connection string.
# In production, use APP_ENV=production, disable demo auth, and provide a strong unique SECRET_KEY.
# When DATABASE_URL is set it takes precedence over DB_HOST/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbit
DB_USER=postgres
DB_PASSWORD=change-me
DB_CONNECT_TIMEOUT=5
# DB_SSLMODE=prefer
# For a managed provider that requires TLS, set DB_SSLMODE=require only when not using a DATABASE_URL override.

# Use only trusted browser origins; never use * with authenticated APIs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# VITE_API_URL=/api
