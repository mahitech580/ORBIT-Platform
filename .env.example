# Copy to .env for local development. Never use these sample values in production.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-local-secret
ENABLE_DEMO_AUTH=true
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbit
DB_USER=postgres
DB_PASSWORD=change-me
DB_CONNECT_TIMEOUT=5
# DB_SSLMODE=prefer

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# VITE_API_URL=/api
